# Google Antigravity SDK Configuration
GEMINI_API_KEY=your_gemini_api_key_here

# Feedback Sources Configuration
RADAR_GITHUB_REPO=google-antigravity/antigravity-sdk-python
GITHUB_TOKEN=your_github_personal_access_token_optional
RADAR_SHEET_CSV=https://docs.google.com/spreadsheets/d/e/.../pub?output=csv
RADAR_GMAIL_QUERY=label:feedback newer_than:30d

# Model & Daemon Settings
RADAR_MODEL=
RADAR_SERVE_INTERVAL=86400
